class CursesApp:
    def __init__(self, stdscr, args):
        self.stdscr = stdscr
        self.args = args
        cfg = load_settings()
        self.skin_name = cfg["skin"]
        self.theme_name = cfg["theme"]
        self.speed_name = cfg["speed"] if not args.speed else args.speed
        if self.speed_name not in SPEEDS:
            self.speed_name = "Normal"
        self.mono = cfg["mono"] or args.mono
        self.engine = PacEngine(seed=args.seed, speed=self.speed_name)
        self.highscore = load_highscore()
        self.new_high = False
        self.paused = False
        self.menu_open = False
        self.menu_index = 0
        self.menu_items = ["Continue", "Restart", "Settings", "Quit"]
        self.in_settings = False
        self.settings_index = 0
        self.over_index = 0
        self._menu_buttons: list[tuple[str, int, int, int]] = []
        self.elapsed = 0.0
        self._pause_started = 0.0
        self.elapsed_pause = 0.0
        self.mouth = 0.0

    # -- settings -----------------------------------------------------------
    def skin(self) -> dict:
        return SKINS[self.skin_name]

    def settings_rows(self):
        return [
            ("Character skin", self.skin_name),
            ("Theme", self.theme_name),
            ("Speed", self.speed_name),
            ("Colors", "OFF (mono)" if self.mono else "ON"),
            ("Reset best score", "press →"),
        ]

    def adjust_setting(self, direction: int) -> None:
        i = self.settings_index
        if i == 0 and direction != 0:
            cur = SKIN_NAMES.index(self.skin_name)
            self.skin_name = SKIN_NAMES[(cur + direction) % len(SKIN_NAMES)]
        elif i == 1 and direction != 0:
            cur = THEME_NAMES.index(self.theme_name)
            self.theme_name = THEME_NAMES[(cur + direction) % len(THEME_NAMES)]
            try:
                _init_colors(self.theme_name)
            except Exception:
                pass
        elif i == 2 and direction != 0:
            cur = SPEED_NAMES.index(self.speed_name)
            self.speed_name = SPEED_NAMES[(cur + direction) % len(SPEED_NAMES)]
            self.engine.speed_mult = SPEEDS[self.speed_name]
        elif i == 3 and direction != 0:
            self.mono = not self.mono
        elif i == 4 and direction != 0:
            self.highscore = 0
            try:
                if os.path.exists(HIGHSCORE_PATH):
                    os.remove(HIGHSCORE_PATH)
            except Exception:
                pass
        self.persist_settings()

    def persist_settings(self) -> None:
        save_settings(self.skin_name, self.theme_name, self.speed_name,
                      self.mono)

    # -- menu state -----------------------------------------------------------
    def open_menu(self, now: float) -> None:
        if self.engine.game_over:
            return
        if not self.menu_open:
            self.menu_open = True
            self.in_settings = False
            self.menu_index = 0
            if not self.paused:
                self.toggle_pause(now)

    def close_menu(self, now: float) -> None:
        self.menu_open = False
        self.in_settings = False
        if self.paused:
            self.toggle_pause(now)

    def toggle_pause(self, now: float) -> None:
        if self.paused:
            self.elapsed_pause += now - self._pause_started
            self.paused = False
        else:
            self._pause_started = now
            self.paused = True

    def restart(self) -> None:
        args, stdscr = self.args, self.stdscr
        skin, theme, speed, mono = (self.skin_name, self.theme_name,
                                    self.speed_name, self.mono)
        highscore = self.highscore
        self.__init__(stdscr, args)
        (self.skin_name, self.theme_name, self.speed_name,
         self.mono) = (skin, theme, speed, mono)
        self.engine.speed_mult = SPEEDS[speed]
        self.highscore = highscore
        _init_colors(theme)

    def on_game_over(self) -> None:
        if self.engine.score > self.highscore:
            self.highscore = self.engine.score
            self.new_high = True
            save_highscore(self.engine.score)

    # -- input ------------------------------------------------------------------
    KEYMAP = {
        "up": ["up", "w", "k"], "down": ["down", "s", "j"],
        "left": ["left", "a", "h"], "right": ["right", "d", "l"],
    }

    def key_to_dir(self, key: int) -> str | None:
        import curses
        if key in (curses.KEY_UP, ord("w"), ord("W"), ord("k"), ord("K")):
            return "up"
        if key in (curses.KEY_DOWN, ord("s"), ord("S"), ord("j"), ord("J")):
            return "down"
        if key in (curses.KEY_LEFT, ord("a"), ord("A"), ord("h"), ord("H")):
            return "left"
        if key in (curses.KEY_RIGHT, ord("d"), ord("D"), ord("l"), ord("L")):
            return "right"
        return None

    def handle_key(self, key: int, now: float) -> str | None:
        import curses
        e = self.engine
        KEY_MOUSE = getattr(curses, "KEY_MOUSE", -9999)
        if key == KEY_MOUSE:
            return self.handle_mouse()

        if self.menu_open and self.in_settings:
            if key in (27, ord("b"), ord("B")):
                self.in_settings = False
                return None
            if key in (curses.KEY_UP, ord("w"), ord("W")):
                self.settings_index = (self.settings_index - 1) % len(self.settings_rows())
                return None
            if key in (curses.KEY_DOWN, ord("s"), ord("S")):
                self.settings_index = (self.settings_index + 1) % len(self.settings_rows())
                return None
            if key in (curses.KEY_LEFT, ord("h"), ord("H"), ord("a"), ord("A")):
                self.adjust_setting(-1)
                return None
            if key in (curses.KEY_RIGHT, ord("l"), ord("L"), ord("d"), ord("D")):
                self.adjust_setting(+1)
                return None
            if key in (curses.KEY_ENTER, 10, 13, ord(" ")):
                self.adjust_setting(+1)
                return None
            if key in (ord("q"), ord("Q")):
                self.in_settings = False
                return None
            return None

        if self.menu_open:
            if key in (curses.KEY_UP, ord("w"), ord("W")):
                self.menu_index = (self.menu_index - 1) % len(self.menu_items)
                return None
            if key in (curses.KEY_DOWN, ord("s"), ord("S")):
                self.menu_index = (self.menu_index + 1) % len(self.menu_items)
                return None
            if key in (curses.KEY_ENTER, 10, 13, ord(" ")):
                return self.activate_menu_item(now)
            if key == 27:
                self.close_menu(now)
                return None
            if key in (ord("p"), ord("P"), ord("c"), ord("C")):
                self.close_menu(now)
                return None
            if key in (ord("r"), ord("R")):
                self.restart()
                return None
            if key in (ord("q"), ord("Q")):
                return "quit"
            for i in range(len(self.menu_items)):
                if key == ord(str(i + 1)):
                    self.menu_index = i
                    return self.activate_menu_item(now)
            return None

        if e.game_over:
            if key in (curses.KEY_LEFT, curses.KEY_RIGHT, 9):
                self.over_index = 1 - self.over_index
                return None
            if key in (curses.KEY_ENTER, 10, 13, ord(" ")):
                return "restart" if self.over_index == 0 else "quit"
            if key in (ord("r"), ord("R")):
                return "restart"
            if key in (ord("q"), ord("Q"), 27):
                return "quit"
            return None

        if key == 27:
            self.open_menu(now)
            return None
        if key in (ord("q"), ord("Q")):
            return "quit"
        if key in (ord("p"), ord("P")):
            self.open_menu(now)
            return None
        if key in (ord("r"), ord("R")):
            return "restart"
        if key in (ord("m"), ord("M")):
            self.mono = not self.mono
            self.persist_settings()
            return None
        if self.paused:
            return None
        d = self.key_to_dir(key)
        if d:
            e.steer(d)
        return None

    def activate_menu_item(self, now: float) -> str | None:
        item = self.menu_items[self.menu_index]
        if item == "Continue":
            self.close_menu(now)
        elif item == "Restart":
            self.restart()
        elif item == "Settings":
            self.in_settings = True
            self.settings_index = 0
        elif item == "Quit":
            return "quit"
        return None

    def handle_mouse(self) -> str | None:
        import curses
        now = time.monotonic()
        try:
            _id, mx, my, _z, _b = curses.getmouse()
        except Exception:
            return None
        for (bid, by, bx, bw) in self._menu_buttons:
            if by == my and bx <= mx < bx + bw:
                if self.engine.game_over and not self.menu_open:
                    return "restart" if bid == "over_restart" else "quit"
                if self.menu_open and not self.in_settings:
                    for i in range(len(self.menu_items)):
                        if bid == f"menu_{i}":
                            self.menu_index = i
                            return self.activate_menu_item(now)
                elif self.menu_open and self.in_settings:
                    if bid == "set_back":
                        self.in_settings = False
        return None

    # -- main loop ------------------------------------------------------------
    def run(self) -> None:
        import curses
        stdscr = self.stdscr
        curses.curs_set(0)
        stdscr.nodelay(True)
        stdscr.timeout(8)
        stdscr.keypad(True)
        try:
            curses.set_escdelay(25)
        except Exception:
            pass
        try:
            _mm = getattr(curses, "BUTTON1_CLICKED", 0) | getattr(
                curses, "BUTTON1_PRESSED", 0) or getattr(curses, "ALL_MOUSE_EVENTS", 0)
            curses.mousemask(_mm)
        except Exception:
            pass
        _init_colors(self.theme_name)

        prev = time.monotonic()
        while True:
            now = time.monotonic()
            dt = min(0.1, now - prev)
            prev = now
            while True:
                try:
                    key = stdscr.getch()
                except Exception:
                    key = -1
                if key == -1:
                    break
                sig = self.handle_key(key, now)
                if sig == "quit":
                    self.on_game_over()
                    return
                if sig == "restart":
                    self.restart()
                    prev = time.monotonic()
                    break
            if not self.paused and not self.engine.game_over:
                self.engine.update(dt)
                if self.engine.game_over:
                    self.on_game_over()
            self.mouth += dt
            self.render(now)
            elapsed = time.monotonic() - now
            if elapsed < 0.005:
                time.sleep(0.005 - elapsed)

    # -- rendering --------------------------------------------------------------
    def pair(self, name: str) -> int:
        import curses
        table = {"maze": 1, "player": 2, "pellet": 7, "fright": 8,
                 "g0": 3, "g1": 4, "g2": 5, "g3": 6}
        try:
            if self.mono:
                return curses.color_pair(20)
            return curses.color_pair(table.get(name, 20))
        except Exception:
            return curses.A_NORMAL

    def put(self, x: int, y: int, text: str, attr: int = 0) -> None:
        try:
            self.stdscr.addstr(y, x, text, attr)
        except Exception:
            pass

    def text_box(self, x: int, y: int, w: int, h: int, title: str = "") -> None:
        import curses
        if h <= 0:
            return
        try:
            self.stdscr.addstr(y, x, "┌" + "─" * (w - 2) + "┐", curses.A_DIM)
            for i in range(1, h - 1):
                self.stdscr.addstr(y + i, x, "│", curses.A_DIM)
                self.stdscr.addstr(y + i, x + w - 1, "│", curses.A_DIM)
            self.stdscr.addstr(y + h - 1, x, "└" + "─" * (w - 2) + "┘", curses.A_DIM)
            if title:
                self.stdscr.addstr(y, x + 2, f" {title} ", curses.A_BOLD)
        except Exception:
            pass

    def mattr(self, kind: str) -> int:
        import curses
        if kind in ("sel", "title"):
            return curses.A_REVERSE | curses.A_BOLD
        if kind == "hint":
            return curses.A_DIM
        return curses.A_BOLD

    def render(self, now: float) -> None:
        import curses
        stdscr = self.stdscr
        stdscr.erase()
        maxy, maxx = stdscr.getmaxyx()
        min_w, min_h = 64, MH + 6
        if maxx < min_w or maxy < min_h:
            for i, line in enumerate([
                    "Terminal too small for Cakeman.",
                    f"Need at least {min_w}x{min_h}, you have {maxx}x{maxy}.",
                    "Resize or press Q to quit."]):
                try:
                    stdscr.addstr(maxy // 2 - 1 + i, max(0, (maxx - len(line)) // 2),
                                  line, curses.A_BOLD)
                except Exception:
                    pass
            stdscr.refresh()
            return

        e = self.engine
        sk = self.skin()
        panel_w = 22
        total_w = panel_w + MW + panel_w + 6
        ox = max(0, (maxx - total_w) // 2)
        oy = max(1, (maxy - (MH + 3)) // 2)
        lx, mx, rx = ox, ox + panel_w + 3, ox + panel_w + 3 + MW + 3

        try:
            stdscr.addstr(max(0, oy - 1), max(0, (maxx - 13) // 2), " C A K E M A N ",
                          curses.A_BOLD | self.pair("player"))
        except Exception:
            pass

        # maze frame
        for r in range(MH):
            sy = oy + 1 + r
            for c in range(MW):
                ch = MAZE[r][c]
                sx = mx + c
                if ch == "#":
                    self.put(sx, sy, sk["wall"], self.pair("maze") | curses.A_BOLD)
                elif ch == "-":
                    self.put(sx, sy, "–", self.pair("maze") | curses.A_DIM)
                else:
                    self.put(sx, sy, " ", 0)
        # crumbs
        for (x, y) in e.pellets:
            self.put(mx + x, oy + 1 + y, sk["pellet"], self.pair("pellet"))
        blink = int(now * 3) % 2 == 0
        for (x, y) in e.powers:
            self.put(mx + x, oy + 1 + y, sk["power"],
                     (self.pair("pellet") | curses.A_BOLD) if blink else self.pair("pellet"))
        # player (skip over frightened-ghost overlap: ghost drawn below wins ties
        # only when edible — actually draw player first, then ghosts)
        if not e.game_over:
            frame = 0 if int(self.mouth * 6) % 2 == 0 else 1
            px, py = e.player["pos"]
            if 0 <= px < MW and 0 <= py < MH:
                try:
                    stdscr.addstr(oy + 1 + py, mx + px, sk["player"][frame],
                                  self.pair("player") | curses.A_BOLD)
                except Exception:
                    pass
        # ghosts
        for i, g in enumerate(e.ghosts):
            x, y = g["pos"]
            if not (0 <= x < MW and 0 <= y < MH):
                continue
            st = g["state"]
            if st == "fright":
                ch, attr = sk["fright"], self.pair("fright") | curses.A_BOLD
            elif st == "eyes":
                ch, attr = sk["eyes"], self.pair("pellet")
            else:
                ch, attr = sk["ghosts"][i], self.pair(f"g{i}") | curses.A_BOLD
            try:
                stdscr.addstr(oy + 1 + y, mx + x, ch, attr)
            except Exception:
                pass

        # left panel: score
        self.text_box(lx, oy, panel_w, 11, "CAKEMAN")
        for i, s in enumerate([
                f"Score  {e.score:>9,}",
                f"Best   {max(self.highscore, e.score):>9,}",
                f"Lives  {'♥' * e.lives + '·' * max(0, 3 - e.lives):>9}",
                f"Level  {e.level:>9}",
                f"Crumbs {len(e.pellets) + len(e.powers):>8}/{e.total_crumbs:<3}",
                f"Mode   {(('FRIGHT!' if e.fright_timer > 0 else e.mode.upper())):>9}",
        ]):
            self.put(lx + 2, oy + 2 + i, s[: panel_w - 3])
        # legend shows the active skin's characters
        self.text_box(lx, oy + 12, panel_w, 7, f"SKIN: {self.skin_name.upper()}")
        self.put(lx + 2, oy + 14, f"You {sk['player'][0]}  foe {sk['fright']}")
        self.put(lx + 2, oy + 15, " ".join(sk["ghosts"]) + "  ghosts")
        self.put(lx + 2, oy + 16, f"{sk['pellet']} crumb  {sk['power']} power")

        # right panel: help
        ry = oy
        self.text_box(rx, ry, panel_w, 12, "HELP")
        for i, s in enumerate([
                "Arrows/WASD move", "turns are buffered", "eat all crumbs!",
                f"{sk['power']} = hunt ghosts", "ghosts pay 200→1600",
                "ESC menu  R restart", "Q quit  M colors",
        ]):
            self.put(rx + 2, ry + 2 + i, s[: panel_w - 3])

        try:
            status = self.status_line(now)
            stdscr.addstr(maxy - 1, max(0, (maxx - len(status)) // 2),
                          status[: maxx - 1], curses.A_DIM)
        except Exception:
            pass

        if self.menu_open:
            if self.in_settings:
                self.draw_settings_menu()
            else:
                self.draw_pause_menu()
        elif e.game_over:
            self.draw_gameover_menu()
        elif e.ready_timer > 0:
            self.center_banner("READY!" if e.lives == 3 and e.level == 1 and e.score == 0
                               else ("LEVEL %d" % e.level))

        stdscr.refresh()

    def status_line(self, now: float) -> str:
        e = self.engine
        if e.game_over:
            return "Game over — ←→ choose · Enter select · Q quit"
        if self.menu_open:
            return "Menu — ↑↓ choose · Enter select · ESC continue"
        return (f"{e.score:,} pts · Lv {e.level} · ♥×{e.lives} · "
                f"{self.skin_name}/{self.theme_name} · ESC menu")

    def center_banner(self, text: str) -> None:
        import curses
        maxy, maxx = self.stdscr.getmaxyx()
        try:
            self.stdscr.addstr(maxy // 2, (maxx - len(text)) // 2, text,
                               curses.A_REVERSE | curses.A_BOLD)
        except Exception:
            pass

    # -- menus (same white/reverse look as caketris) ------------------------------
    def menu_button(self, y: int, x: int, label: str, selected: bool,
                    bid: str) -> int:
        text = f"[ {label} ]"
        if selected:
            text = f"[▶ {label} ]"
        w = len(text)
        try:
            self.stdscr.addstr(y, x, text, self.mattr("sel") if selected
                               else self.mattr("text"))
        except Exception:
            pass
        self._menu_buttons.append((bid, y, x, w))
        return w

    def menu_panel(self, title: str, inner_h: int, inner_w: int):
        maxy, maxx = self.stdscr.getmaxyx()
        w, h = inner_w + 6, inner_h + 4
        x0, y0 = max(0, (maxx - w) // 2), max(0, (maxy - h) // 2)
        try:
            self.stdscr.addstr(y0, x0, "┌" + "─" * (w - 2) + "┐", self.mattr("text"))
            for yy in range(y0 + 1, y0 + h - 1):
                self.stdscr.addstr(yy, x0, "│", self.mattr("text"))
                self.stdscr.addstr(yy, x0 + w - 1, "│", self.mattr("text"))
            self.stdscr.addstr(y0 + h - 1, x0, "└" + "─" * (w - 2) + "┘",
                               self.mattr("text"))
            self.stdscr.addstr(y0 + 1, x0 + (w - len(title)) // 2, title,
                               self.mattr("title"))
        except Exception:
            pass
        return x0, y0

    def draw_pause_menu(self) -> None:
        self._menu_buttons = []
        e = self.engine
        inner_w = 30
        x0, y0 = self.menu_panel(f"Ⅱ PAUSED — {e.score:,} pts",
                                 len(self.menu_items) + 3, inner_w)
        try:
            for i, item in enumerate(self.menu_items):
                self.menu_button(y0 + 3 + i,
                                 x0 + (inner_w + 6 - (len(item) + 6)) // 2,
                                 f"{i + 1}. {item}", i == self.menu_index,
                                 f"menu_{i}")
            hint = "↑↓ navigate · Enter select · ESC continue"
            self.stdscr.addstr(y0 + 3 + len(self.menu_items) + 1,
                               x0 + (inner_w + 6 - len(hint)) // 2, hint,
                               self.mattr("hint"))
        except Exception:
            pass

    def draw_settings_menu(self) -> None:
        rows = self.settings_rows()
        inner_w = 36
        x0, y0 = self.menu_panel("⚙ SETTINGS", len(rows) + 3, inner_w)
        hint = "↑↓ row · ←→ change · ESC back"
        hy, hx = y0 + 3 + len(rows) + 1, x0 + (inner_w + 6 - len(hint)) // 2
        self._menu_buttons = [("set_back", hy, hx, len(hint))]
        try:
            for i, (name, val) in enumerate(rows):
                by = y0 + 3 + i
                marker = "▶" if i == self.settings_index else " "
                self.stdscr.addstr(by, x0 + 3, f"{marker} {name}"[:22].ljust(22),
                                   self.mattr("sel") if i == self.settings_index
                                   else self.mattr("text"))
                self.stdscr.addstr(by, x0 + 3 + 23, f"< {val} >",
                                   self.mattr("title"))
            self.stdscr.addstr(hy, hx, hint, self.mattr("hint"))
        except Exception:
            pass

    def draw_gameover_menu(self) -> None:
        e = self.engine
        hs = max(self.highscore, e.score)
        title = "GAME OVER" + ("  ★ NEW BEST!" if self.new_high else "")
        stats = [f"Score  {e.score:,}", f"Level  {e.level}", f"Best   {hs:,}"]
        inner_w = 32
        x0, y0 = self.menu_panel(title, len(stats) + 4, inner_w)
        by = y0 + 3 + len(stats) + 1
        b0 = "[▶ Restart ]" if self.over_index == 0 else "[ Restart ]"
        b1 = "[▶ Quit ]" if self.over_index == 1 else "[ Quit ]"
        gap = 4
        bx = x0 + (inner_w + 6 - (len(b0) + gap + len(b1))) // 2
        self._menu_buttons = [("over_restart", by, bx, len(b0)),
                              ("over_quit", by, bx + len(b0) + gap, len(b1))]
        try:
            for i, s in enumerate(stats):
                self.stdscr.addstr(y0 + 3 + i, x0 + (inner_w + 6 - len(s)) // 2,
                                   s, self.mattr("title"))
            self.stdscr.addstr(by, bx, b0, self.mattr("sel") if self.over_index == 0
                               else self.mattr("text"))
            self.stdscr.addstr(by, bx + len(b0) + gap, b1,
                               self.mattr("sel") if self.over_index == 1
                               else self.mattr("text"))
            hint = "←→ choose · Enter select · R restart"
            self.stdscr.addstr(by + 2, x0 + (inner_w + 6 - len(hint)) // 2,
                               hint, self.mattr("hint"))
        except Exception:
            pass


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Cakeman — Pac-Man-style terminal chase")
    parser.add_argument("--seed", type=int, default=None, help="RNG seed")
    parser.add_argument("--speed", choices=SPEED_NAMES, default=None,
                        help="game speed (overrides saved setting)")
    parser.add_argument("--mono", action="store_true", help="disable colors")
    parser.add_argument("--test", action="store_true", help="run headless self-test and exit")
    args = parser.parse_args(argv)

    if args.test:
        return run_selftest()

    try:
        import curses  # noqa
    except Exception as exc:
        if os.name == "nt":
            print("This game needs curses. On Windows:\n  pip install windows-curses",
                  file=sys.stderr)
            return 2
        print(f"curses is required: {exc}", file=sys.stderr)
        return 2
    import curses

    def _wrapped(stdscr):
        CursesApp(stdscr, args).run()

    try:
        curses.wrapper(_wrapped)
    except KeyboardInterrupt:
        pass
    return 0


# --------------------------------------------------------------------------
# Headless self-test
# --------------------------------------------------------------------------

def run_selftest() -> int:
    fails = []

    def check(name: str, cond: bool, detail: str = ""):
        print(("PASS " if cond else "FAIL ") + name + (f" — {detail}" if detail and not cond else ""))
        if not cond:
            fails.append(name)

    # 1. maze rectangular + symmetric + bordered (tunnel row excepted)
    check("maze-rect", all(len(r) == MW for r in MAZE), str([len(r) for r in MAZE]))
    check("maze-sym", all(r == r[::-1] for r in MAZE))
    bad = [i for i, r in enumerate(MAZE)
           if not (r[0] in "# " and r[-1] in "# ")]
    check("maze-border", not bad, str(bad))
    # 2. crumbs exist, house + door sane
    e = PacEngine(seed=1)
    e.ready_timer = 0
    check("crumbs-exist", len(e.pellets) > 150 and len(e.powers) == 4,
          f"{len(e.pellets)} pellets, {len(e.powers)} powers")
    check("house-door", all(MAZE[y][x] == "-" for (x, y) in DOOR))
    # 3. walls block movement
    e.player["pos"] = (1, 1)
    e.player["dir"] = e.player["buf"] = "left"
    e._step_player()
    check("wall-blocks", e.player["pos"] == (1, 1))
    # 4. eating a pellet scores
    e.player["pos"] = (1, 1)
    e.player["dir"] = e.player["buf"] = "right"
    s0 = e.score
    e._step_player()  # (2,1) has a pellet
    check("pellet-scores", e.score == s0 + 10 and (2, 1) not in e.pellets)
    # 5. power treat -> fright
    e2 = PacEngine(seed=2)
    e2.ready_timer = 0
    e2.player["pos"] = (1, 2)
    e2.player["dir"] = e2.player["buf"] = "down"  # (1,3) is a power treat
    e2._step_player()
    check("power-fright", e2.fright_timer > 0 and
          all(g["state"] in ("fright", "house", "leaving") for g in e2.ghosts),
          f"fright={e2.fright_timer}")
    # 6. frightened ghost eaten -> eyes + 200 pts chain
    e3 = PacEngine(seed=3)
    e3.ready_timer = 0
    e3.ghosts[0]["pos"] = e3.player["pos"] = (9, 15)
    e3.ghosts[0]["state"] = "fright"
    s0 = e3.score
    e3._collisions()
    check("ghost-eaten", e3.ghosts[0]["state"] == "eyes" and e3.score == s0 + 200)
    # 7. normal ghost touch -> lose a life
    e4 = PacEngine(seed=4)
    e4.ready_timer = 0
    e4.ghosts[1]["pos"] = e4.player["pos"] = (9, 15)
    e4.ghosts[1]["state"] = "active"
    e4._collisions()
    check("death-costs-life", e4.lives == 2 and e4.player["pos"] == PLAYER_START)
    # 8. tunnel wraps
    e5 = PacEngine(seed=5)
    e5.ready_timer = 0
    e5.player["pos"] = (0, 10)
    e5.player["dir"] = e5.player["buf"] = "left"
    e5._step_player()
    check("tunnel-wraps", e5.player["pos"] == (MW - 1, 10), str(e5.player["pos"]))
    # 9. clearing crumbs -> next level
    e6 = PacEngine(seed=6)
    e6.ready_timer = 0
    e6.pellets.clear()
    e6.powers.clear()
    e6.powers.add((9, 15))
    e6.player["pos"] = (8, 15)
    e6.player["dir"] = e6.player["buf"] = "right"
    lv = e6.level
    e6._step_player()
    check("level-clear", e6.level == lv + 1 and len(e6.pellets) > 100)
    # 10. ghost personalities target different tiles
    e7 = PacEngine(seed=7)
    e7.ready_timer = 0
    e7.player["pos"] = (9, 15)
    e7.player["dir"] = "left"
    e7.mode = "chase"
    targets = {e7._ghost_target(g) for g in e7.ghosts}
    check("personalities-differ", len(targets) >= 3, str(targets))
    # 11. skins/themes valid: distinct chars, real color names
    ok = True
    for name, sk in SKINS.items():
        chars = [sk["player"][0]] + sk["ghosts"]
        if len(set(chars)) < 5:
            ok = False
        for k in ("fright", "eyes", "pellet", "power", "wall"):
            if len(sk[k]) != 1:
                ok = False
    check("skins-distinct", ok)
    ok = all(set(t) == {"maze", "player", "ghosts", "pellet"} and len(t["ghosts"]) == 4
             for t in THEMES.values())
    check("themes-valid", ok)
    # 12. update() runs without errors for a while
    e8 = PacEngine(seed=8)
    e8.ready_timer = 0
    try:
        for i in range(3000):
            if i % 3 == 0:
                e8.steer(["up", "left", "down", "right"][i % 4])
            e8.update(0.03)
        check("soak-no-crash", True)
    except Exception as exc:
        check("soak-no-crash", False, str(exc))

    total = 12
    print(f"\n{total - len(fails)}/{total} checks passed.")
    return 1 if fails else 0


if __name__ == "__main__":
    raise SystemExit(main())
