def fright_time(level: int) -> float:
    return max(6.0 - 0.7 * (level - 1), 1.5)


def load_highscore() -> int:
    try:
        with open(HIGHSCORE_PATH, "r", encoding="utf-8") as f:
            return int(json.load(f).get("highscore", 0))
    except Exception:
        return 0


def save_highscore(score: int) -> None:
    try:
        if score <= load_highscore():
            return
        with open(HIGHSCORE_PATH, "w", encoding="utf-8") as f:
            json.dump({"highscore": int(score)}, f)
    except Exception:
        pass


def load_settings() -> dict:
    defaults = {"skin": "Cake", "theme": "Classic", "speed": "Normal",
                "mono": False}
    try:
        with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        for k in defaults:
            if k in data:
                defaults[k] = data[k]
        if defaults["skin"] not in SKINS:
            defaults["skin"] = "Cake"
        if defaults["theme"] not in THEMES:
            defaults["theme"] = "Classic"
        if defaults["speed"] not in SPEEDS:
            defaults["speed"] = "Normal"
    except Exception:
        pass
    return defaults


def save_settings(skin: str, theme: str, speed: str, mono: bool) -> None:
    try:
        with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
            json.dump({"skin": skin, "theme": theme, "speed": speed,
                       "mono": mono}, f)
    except Exception:
        pass


# --------------------------------------------------------------------------
# Engine (no curses — fully testable headless)
# --------------------------------------------------------------------------

DIRS = {"up": (0, -1), "down": (0, 1), "left": (-1, 0), "right": (1, 0)}
OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}


def _manhattan(a, b) -> int:
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


class PacEngine:
    def __init__(self, seed: int | None = None, speed: str = "Normal"):
        self.rng = random.Random(seed)
        self.speed_mult = SPEEDS.get(speed, 1.0)
        self.score = 0
        self.lives = 3
        self.level = 1
        self.game_over = False
        self.ready_timer = 1.6  # "READY!" freeze at run/level start
        self._build_level()
        self.reset_positions()
        self.release_timers = [0.0, 1.5, 4.0, 7.0]

    # -- maze -------------------------------------------------------------
    def _build_level(self) -> None:
        self.pellets: set[tuple[int, int]] = set()
        self.powers: set[tuple[int, int]] = set()
        for y, row in enumerate(MAZE):
            for x, ch in enumerate(row):
                if ch == ".":
                    self.pellets.add((x, y))
                elif ch == "o":
                    self.powers.add((x, y))
        self.total_crumbs = len(self.pellets) + len(self.powers)

    def cell(self, x: int, y: int) -> str:
        if 0 <= y < MH and 0 <= x < MW:
            return MAZE[y][x]
        return " "

    def walkable(self, x: int, y: int, ghost: bool = False,
                 can_door: bool = False) -> bool:
        if y == 10 and (x < 0 or x >= MW):
            return True  # tunnel row wraps sideways
        if not (0 <= x < MW and 0 <= y < MH):
            return False
        ch = MAZE[y][x]
        if ch == "#":
            return False
        if (x, y) in DOOR or ch == "-":
            return ghost and can_door
        if ch == "G":
            return ghost and can_door
        return True

    # -- actors -------------------------------------------------------------
    def reset_positions(self) -> None:
        self.player = {"pos": PLAYER_START, "dir": "left", "buf": "left"}
        self.ghosts = []
        for i in range(4):
            self.ghosts.append({
                "name": GHOST_NAMES[i], "pos": HOUSE[i % len(HOUSE)],
                "dir": "up" if i < 2 else "down",
                "state": "house",  # house | leaving | active | fright | eyes
                "corner": SCATTER_CORNERS[i],
                "acc": 0.0,
            })
        self.player_acc = 0.0
        self.fright_timer = 0.0
        self.ghost_chain = 0
        self.mode = "scatter"
        self.mode_timer = 0.0
        self.mode_stage = 0
        self.release_timers = [0.0, 1.5, 4.0, 7.0]
        self.ready_timer = max(self.ready_timer, 0.0)

    def player_interval(self) -> float:
        return max(BASE_PLAYER * self.speed_mult - 0.004 * (self.level - 1), 0.055)

    def ghost_interval(self, state: str) -> float:
        if state == "eyes":
            return BASE_EYES
        if state == "fright":
            return BASE_FRIGHT * self.speed_mult
        return max((BASE_GHOST - 0.005 * (self.level - 1)) * self.speed_mult, 0.07)

    # -- per-frame update -----------------------------------------------------
    def update(self, dt: float) -> None:
        if self.game_over:
            return
        if self.ready_timer > 0:
            self.ready_timer -= dt
            return
        # release timers for house ghosts
        for i, g in enumerate(self.ghosts):
            if g["state"] == "house":
                self.release_timers[i] -= dt
                if self.release_timers[i] <= 0:
                    g["state"] = "leaving"
        # scatter/chase waves
        self.mode_timer += dt
        schedule = [("scatter", 4.0), ("chase", 12.0), ("scatter", 4.0),
                    ("chase", 14.0), ("scatter", 3.0), ("chase", 1e9)]
        want, dur = schedule[min(self.mode_stage, len(schedule) - 1)]
        if self.mode != want:
            self.mode = want
            for g in self.ghosts:
                if g["state"] in ("active", "fright"):
                    g["dir"] = OPPOSITE[g["dir"]]  # classic turnaround
        if self.mode_timer >= dur and self.mode_stage < len(schedule) - 1:
            self.mode_timer = 0.0
            self.mode_stage += 1
        # fright countdown
        if self.fright_timer > 0:
            self.fright_timer -= dt
            if self.fright_timer <= 0:
                self.fright_timer = 0
                self.ghost_chain = 0
                for g in self.ghosts:
                    if g["state"] == "fright":
                        g["state"] = "active"
        # move player + ghosts
        self.player_acc += dt
        while self.player_acc >= self.player_interval():
            self.player_acc -= self.player_interval()
            self._step_player()
            if self.game_over:
                return
        for g in self.ghosts:
            g["acc"] += dt
            iv = self.ghost_interval(g["state"] if g["state"] != "leaving" else "active")
            steps = 0
            while g["acc"] >= iv and steps < 4:
                g["acc"] -= iv
                steps += 1
                self._step_ghost(g)
                if self.game_over:
                    return
        self._collisions()

    # -- player ---------------------------------------------------------------
    def steer(self, d: str) -> None:
        if d in DIRS:
            self.player["buf"] = d

    def _step_player(self) -> None:
        p = self.player
        # try buffered turn first
        bx, by = DIRS[p["buf"]]
        nx, ny = (p["pos"][0] + bx) % MW, p["pos"][1] + by
        if self.walkable(nx, ny):
            p["dir"] = p["buf"]
        dx, dy = DIRS[p["dir"]]
        nx, ny = (p["pos"][0] + dx) % MW, p["pos"][1] + dy
        if not self.walkable(nx, ny):
            return  # wall: wait
        p["pos"] = (nx, ny)
        if (nx, ny) in self.pellets:
            self.pellets.discard((nx, ny))
            self.score += 10
        elif (nx, ny) in self.powers:
            self.powers.discard((nx, ny))
            self.score += 50
            self.start_fright()
        if not self.pellets and not self.powers:
            self._level_clear()

    def start_fright(self) -> None:
        self.fright_timer = fright_time(self.level)
        self.ghost_chain = 0
        for g in self.ghosts:
            if g["state"] == "active":
                g["state"] = "fright"
                g["dir"] = OPPOSITE[g["dir"]]

    def _level_clear(self) -> None:
        self.level += 1
        self.score += 500
        self._build_level()
        self.reset_positions()
        self.ready_timer = 1.6

    # -- ghosts -----------------------------------------------------------------
    def _ghost_target(self, g) -> tuple[int, int]:
        px, py = self.player["pos"]
        dx, dy = DIRS[self.player["dir"]]
        if g["state"] == "eyes":
            return EYE_REVIVE
        if self.mode == "scatter" or g["state"] == "house":
            return g["corner"]
        i = GHOST_NAMES.index(g["name"])
        if i == 0:
            return (px, py)
        if i == 1:
            return (px + 4 * dx, py + 4 * dy)
        if i == 2:
            b = self.ghosts[0]["pos"]
            return (px + (px - b[0]), py + (py - b[1]))
        # Clyde: shy — backs off when close
        if _manhattan(g["pos"], (px, py)) > 6:
            return (px, py)
        return g["corner"]

    def _step_ghost(self, g) -> None:
        x, y = g["pos"]
        if g["state"] == "house":
            return
        if g["state"] == "leaving":
            self._step_leaving(g)
            return
        can_door = g["state"] == "eyes"
        if g["state"] == "fright":
            # random turn, no reversing unless dead end
            opts = self._exits(x, y, g["dir"], ghost=True, can_door=False)
            if opts:
                g["dir"] = self.rng.choice(opts)
            g["pos"] = self._advance(g["pos"], g["dir"])
            return
        target = self._ghost_target(g)
        opts = self._exits(x, y, g["dir"], ghost=True, can_door=can_door)
        if not opts:
            g["dir"] = OPPOSITE[g["dir"]]
            g["pos"] = self._advance(g["pos"], g["dir"])
            return
        best = min(opts, key=lambda d: _manhattan(self._advance((x, y), d), target))
        g["dir"] = best
        g["pos"] = self._advance((x, y), best)
        if g["state"] == "eyes" and g["pos"] == EYE_REVIVE:
            g["state"] = "leaving"  # dive back in, then out again

    def _step_leaving(self, g) -> None:
        # path: shuffle to x=8 inside house, up through the door, out
        x, y = g["pos"]
        if (x, y) == (8, 10) or (x, y) in DOOR:
            pass
        if y == 10 and x != 8:
            g["pos"] = (x - 1 if x > 8 else x + 1, 10)
        elif y == 10:
            g["pos"] = (8, 9)
        elif (x, y) in DOOR:
            g["pos"] = (8, 8)
        elif (x, y) == (8, 8):
            g["state"] = "active"
            g["dir"] = "left"
        else:  # eyes arriving from outside funnel to the door
            g["pos"] = (8, 9) if x == 8 else (x, y)

    def _exits(self, x: int, y: int, cur: str, ghost: bool,
               can_door: bool) -> list[str]:
        out = []
        for d, (dx, dy) in DIRS.items():
            if d == OPPOSITE[cur]:
                continue
            nx = (x + dx) % MW if y == 10 else x + dx
            ny = y + dy
            if self.walkable(nx, ny, ghost=ghost, can_door=can_door):
                # ghosts avoid climbing back into the house while active
                if ghost and not can_door and (nx, ny) in DOOR:
                    continue
                out.append(d)
        return out

    def _advance(self, pos, d: str) -> tuple[int, int]:
        dx, dy = DIRS[d]
        x = (pos[0] + dx) % MW if pos[1] == 10 else pos[0] + dx
        return (x, pos[1] + dy)

    # -- collisions ---------------------------------------------------------------
    def _collisions(self) -> None:
        p = self.player["pos"]
        for g in self.ghosts:
            if g["pos"] != p or g["state"] in ("house", "leaving", "eyes"):
                continue
            if g["state"] == "fright":
                self.ghost_chain += 1
                self.score += 200 * (2 ** (self.ghost_chain - 1))
                g["state"] = "eyes"
                g["acc"] = 0.0
            else:
                self._death()
                return

    def _death(self) -> None:
        self.lives -= 1
        if self.lives <= 0:
            self.game_over = True
            return
        self.reset_positions()
        self.ready_timer = 1.4


