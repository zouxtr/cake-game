#!/usr/bin/env python3
"""
Alien-Break — a Breakout clone for the Linux terminal.

  alien-break            # play
  alien-break --help     # options

Controls:
  ← / →  or  H / L   move paddle ONE cell per press (hold to run)
  Mouse              optional: paddle follows the cursor (Settings)
  SPACE              launch the ball / relaunch after losing one
  ESC / P            pause menu (Continue · Restart · Settings · Quit)
  R                  quick restart
  Q                  quit
  M                  toggle colors

Clear every brick to advance — endless levels, faster each time.
Bricks up top pay more. Three lives per run. Skins change the ball,
paddle and bricks; themes recolor the wall. Both live in Settings and
persist between runs. Requires only the Python standard library.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import sys
import time

# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------

FIELD_W, FIELD_H = 38, 20
PADDLE_W = 7
PADDLE_Y = FIELD_H - 2
BRICK_COLS, BRICK_ROWS = 12, 5
BRICK_TOP = 2
BASE_BALL = 15.0
GLIDE_SPEED = 24.0  # paddle cells/sec while a direction is held
HOLD_DAS = 0.12     # hold this long before smooth gliding kicks in
HOLD_EXPIRE = 0.15  # no repeat event for this long = key released
HIT_BOOST = 1.02
MAX_BALL_MULT = 2.4
MIN_VY_FRACTION = 0.30  # ball never goes (near-)horizontal

HIGHSCORE_PATH = os.path.join(os.path.expanduser("~"), ".alien-break_highscore.json")
SETTINGS_PATH = os.path.join(os.path.expanduser("~"), ".alien-break_settings.json")

SKINS: dict[str, dict[str, str]] = {
    "Alien": {"ball": "O", "paddle": "#", "brick": "X"},
    "Retro": {"ball": "*", "paddle": "=", "brick": "+"},
    "Round": {"ball": "o", "paddle": "H", "brick": "x"},
    "Blocks": {"ball": "●", "paddle": "█", "brick": "▓"},
}
SKIN_NAMES = list(SKINS.keys())

THEMES: dict[str, dict[str, str]] = {
    "Classic": {"ball": "WHITE", "paddle": "CYAN", "brick": "MAGENTA",
                "wall": "BLUE"},
    "Candy": {"ball": "YELLOW", "paddle": "MAGENTA", "brick": "CYAN",
              "wall": "MAGENTA"},
    "Midnight": {"ball": "CYAN", "paddle": "WHITE", "brick": "BLUE",
                 "wall": "BLUE"},
    "Forest": {"ball": "YELLOW", "paddle": "GREEN", "brick": "GREEN",
               "wall": "GREEN"},
}
THEME_NAMES = list(THEMES.keys())

SPEEDS = {"Chill": 0.8, "Normal": 1.0, "Turbo": 1.25}
SPEED_NAMES = list(SPEEDS.keys())
LIVES_OPTIONS = [3, 5]

# Paddle input: Keys (tap/hold) or Mouse (paddle follows the cursor;
# keys keep working as a fallback in both modes).
PADDLE_MODES = ["Keys", "Mouse"]

# Brick layouts over a 12x5 grid ('#' = brick). Cycled per level.
LAYOUTS = [
    [
        "############",
        "############",
        "############",
        "############",
        "############",
    ],
    [
        "#.#.#.#.#.#.",
        ".#.#.#.#.#.#",
        "#.#.#.#.#.#.",
        ".#.#.#.#.#.#",
        "#.#.#.#.#.#.",
    ],
    [
        ".....##.....",
        "....####....",
        "...######...",
        "..########..",
        ".##########.",
    ],
    [
        "##..####..##",
        "##..####..##",
        "..######..##",
        "..######....",
        "##..####..##",
    ],
]


def load_best() -> int:
    try:
        with open(HIGHSCORE_PATH, "r", encoding="utf-8") as f:
            return int(json.load(f).get("best", 0))
    except Exception:
        return 0


def save_best(score: int) -> None:
    try:
        if score <= load_best():
            return
        with open(HIGHSCORE_PATH, "w", encoding="utf-8") as f:
            json.dump({"best": int(score)}, f)
    except Exception:
        pass


def load_settings() -> dict:
    defaults = {"skin": "Alien", "theme": "Classic", "speed": "Normal",
                "lives": 3, "paddle": "Keys", "mono": False}
    try:
        with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        for k in defaults:
            if k in data:
                defaults[k] = data[k]
        if defaults["skin"] not in SKINS:
            defaults["skin"] = "Alien"
        if defaults["theme"] not in THEMES:
            defaults["theme"] = "Classic"
        if defaults["speed"] not in SPEEDS:
            defaults["speed"] = "Normal"
        if defaults["lives"] not in LIVES_OPTIONS:
            defaults["lives"] = 3
        if defaults["paddle"] not in PADDLE_MODES:
            defaults["paddle"] = "Keys"
    except Exception:
        pass
    return defaults


def save_settings(skin: str, theme: str, speed: str, lives: int,
                  paddle: str, mono: bool) -> None:
    try:
        with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
            json.dump({"skin": skin, "theme": theme, "speed": speed,
                       "lives": lives, "paddle": paddle, "mono": mono}, f)
    except Exception:
        pass


# --------------------------------------------------------------------------
# Engine (no curses — fully testable headless)
# --------------------------------------------------------------------------

def brick_rect(col: int, row: int) -> tuple[float, float, float, float]:
    """Cell-space rect (x0, y0, x1, y1) of a brick grid cell."""
    w = FIELD_W / BRICK_COLS
    return (col * w, BRICK_TOP + row, (col + 1) * w, BRICK_TOP + row + 1)


class BreakEngine:
    def __init__(self, seed: int | None = None, speed: str = "Normal",
                 lives: int = 3):
        self.rng = random.Random(seed)
        self.speed_mult = SPEEDS.get(speed, 1.0)
        self.max_lives = lives if lives in LIVES_OPTIONS else 3
        self.score = 0
        self.lives = self.max_lives
        self.level = 1
        self.game_over = False
        self.stuck = True  # ball glued to paddle until launch
        self.countdown = 1.0
        self.ball_speed = BASE_BALL * self.speed_mult
        self.reset_positions()
        self.build_bricks()

    def reset_positions(self) -> None:
        self.paddle_x = (FIELD_W - PADDLE_W) / 2  # left edge, float
        self.ball = {"x": FIELD_W / 2, "y": PADDLE_Y - 1.0,
                     "vx": 0.0, "vy": 0.0}
        self.stuck = True

    def build_bricks(self) -> None:
        layout = LAYOUTS[(self.level - 1) % len(LAYOUTS)]
        self.bricks: set[tuple[int, int]] = set()
        for r, line in enumerate(layout):
            for c, ch in enumerate(line):
                if ch == "#":
                    self.bricks.add((c, r))

    def launch(self) -> bool:
        """Release a stuck ball. Returns True if launched."""
        if self.game_over or not self.stuck or self.countdown > 0:
            return False
        import math
        ang = self.rng.uniform(-0.5, 0.5)
        self.ball["vx"] = self.ball_speed * math.sin(ang)
        self.ball["vy"] = -self.ball_speed * math.cos(ang)
        self.stuck = False
        return True

    def nudge_paddle(self, direction: int) -> None:
        """Move the paddle exactly one cell (one key press = one cell)."""
        if self.game_over:
            return
        self._shift(direction * 1.0)

    def glide(self, dt: float, direction: int) -> None:
        """Smooth held-key motion: constant velocity, framerate-independent."""
        if self.game_over:
            return
        self._shift(direction * GLIDE_SPEED * self.speed_mult * dt)

    def _shift(self, dx: float) -> None:
        self.paddle_x = min(max(self.paddle_x + dx, 0.0),
                            FIELD_W - PADDLE_W)
        if self.stuck:
            self.ball["x"] = min(max(self.ball["x"] + dx,
                                     0.5), FIELD_W - 0.5)

    def aim_mouse(self, mouse_x: float, field_left: float) -> None:
        """Bind the paddle to the cursor: center it on the pointer column
        (a stuck ball rides along)."""
        target = mouse_x - field_left - PADDLE_W / 2
        self._shift(target - self.paddle_x)

    def update(self, dt: float) -> None:
        if self.game_over:
            return
        if self.countdown > 0:
            self.countdown -= dt
            return
        if self.stuck:
            return
        b = self.ball
        dist = abs(b["vx"]) * dt + abs(b["vy"]) * dt
        steps = max(1, min(10, int(dist / 0.4) + 1))
        for _ in range(steps):
            if self.game_over or self.stuck:
                return
            self._step_ball(dt / steps)

    def _step_ball(self, dt: float) -> None:
        b = self.ball
        prev_x, prev_y = b["x"], b["y"]
        b["x"] += b["vx"] * dt
        b["y"] += b["vy"] * dt
        # side walls
        if b["x"] <= 0.5:
            b["x"] = 0.5
            b["vx"] = abs(b["vx"])
        elif b["x"] >= FIELD_W - 0.5:
            b["x"] = float(FIELD_W - 0.5)
            b["vx"] = -abs(b["vx"])
        # ceiling
        if b["y"] <= 0.5:
            b["y"] = 0.5
            b["vy"] = abs(b["vy"])
        # paddle (only when falling)
        if b["vy"] > 0 and prev_y <= PADDLE_Y - 0.5 <= b["y"]:
            if self.paddle_x - 0.5 <= b["x"] <= self.paddle_x + PADDLE_W - 0.5:
                self._bounce_paddle()
        # bricks
        hit = self._brick_at(b["x"], b["y"])
        if hit is not None:
            self._break_brick(hit, prev_x, prev_y)
        # missed entirely
        if b["y"] >= FIELD_H:
            self._lose_ball()
        self._fix_angle()

    def _bounce_paddle(self) -> None:
        b = self.ball
        offset = (b["x"] - (self.paddle_x + PADDLE_W / 2)) / (PADDLE_W / 2)
        offset = min(max(offset, -1.0), 1.0)
        import math
        ang = offset * 1.05
        b["vx"] = self.ball_speed * math.sin(ang)
        b["vy"] = -abs(self.ball_speed * math.cos(ang))
        b["y"] = PADDLE_Y - 0.5

    def _brick_at(self, x: float, y: float) -> tuple[int, int] | None:
        w = FIELD_W / BRICK_COLS
        c = int(x // w)
        r = int(y - BRICK_TOP)
        if (c, r) in self.bricks:
            return (c, r)
        return None

    def _break_brick(self, hit: tuple[int, int],
                     prev_x: float, prev_y: float) -> None:
        c, r = hit
        self.bricks.discard(hit)
        # points: higher rows pay more
        self.score += (BRICK_ROWS - r) * 10
        # bounce away along the shallow axis of entry
        x0, y0, x1, y1 = brick_rect(c, r)
        b = self.ball
        if prev_x < x0 or prev_x > x1:
            b["vx"] = -b["vx"]
            b["x"] = x0 - 0.01 if prev_x < x0 else x1 + 0.01
        else:
            b["vy"] = -b["vy"]
            b["y"] = y0 - 0.01 if prev_y < y0 else y1 + 0.01
        self.ball_speed = min(self.ball_speed * HIT_BOOST,
                              BASE_BALL * self.speed_mult * MAX_BALL_MULT)
        # rescale velocity to the new speed, keeping direction
        import math
        ang = math.atan2(b["vx"], -b["vy"])
        b["vx"] = self.ball_speed * math.sin(ang)
        b["vy"] = -self.ball_speed * math.cos(ang)
        self._fix_angle()
        if not self.bricks:
            self._level_clear()

    def _fix_angle(self) -> None:
        """Keep the ball from settling into (near-)horizontal loops."""
        import math
        b = self.ball
        sp = math.hypot(b["vx"], b["vy"])
        if sp <= 0:
            return
        min_vy = sp * MIN_VY_FRACTION
        if abs(b["vy"]) < min_vy:
            sign = 1.0 if b["vy"] >= 0 else -1.0
            b["vy"] = sign * min_vy
            b["vx"] = math.copysign(math.sqrt(max(sp * sp - b["vy"] ** 2, 0.0)),
                                    b["vx"])

    def _lose_ball(self) -> None:
        self.lives -= 1
        if self.lives <= 0:
            self.game_over = True
            return
        self.ball_speed = BASE_BALL * self.speed_mult
        self.reset_positions()

    def _level_clear(self) -> None:
        self.level += 1
        self.score += 250
        self.ball_speed = BASE_BALL * self.speed_mult * min(
            1.0 + 0.12 * (self.level - 1), MAX_BALL_MULT)
        self.build_bricks()
        self.reset_positions()


