#!/usr/bin/env python3
"""
Alientris — a polished Tetris for the Linux terminal.

  alientris            # play
  alientris --help     # options

Controls (default):
  ← / →  or  H / L   move (exactly one cell per press)
  ↓ / S / J          hold for fast fall (soft drop, +1/cell)
  ↑ / X / W          rotate clockwise
  Z                  rotate counter-clockwise
  A                  rotate 180
  SPACE              hard drop
  C                  hold
  ESC / P            pause menu (Continue · Restart · Settings · Quit)
  R                  quick restart
  Q                  quit
  M                  toggle ghost piece

Pause menu: ↑↓ + Enter (mouse-clickable where supported).
Settings: ghost piece, color/mono, next-preview count, reset best score.

Features: 7-bag randomizer, SRS-style wall kicks, ghost piece, hold,
5-piece preview, levels + gravity curve, guideline scoring with
combo + back-to-back, lock delay, one-cell-per-press movement (terminal
key-repeat handles holding), soft/hard drop scoring, line-clear flash,
ESC pause menu (continue/restart/settings/quit) + game-over menu,
persistent high score, centered responsive layout, color + monochrome.
Requires only the Python standard library (curses).
"""

from __future__ import annotations

import argparse
import copy
import json
import os
import random
import sys
import time

# --------------------------------------------------------------------------
# Config / tuning
# --------------------------------------------------------------------------

WIDTH = 10
HEIGHT = 20
VISIBLE_NEXT = 5

DAS = 0.150   # legacy (unused): movement is 1 cell per key event now
ARR = 0.045   # legacy (unused): holding relies on terminal key-repeat
SOFT_DROP_INTERVAL = 0.08  # seconds per row while Down held (~12 rows/s).
# Tune this one number to taste: smaller = faster soft drop.
LOCK_DELAY = 0.50
MAX_LOCK_RESETS = 15
LINE_FLASH_TIME = 0.18

# Guideline-ish gravity: seconds per row per level (1..15+)
def gravity_for_level(level: int) -> float:
    level = max(1, level)
    if level in _GRAVITY_CACHE:
        return _GRAVITY_CACHE[level]
    # classic formula (0.8 - (lvl-1)*0.007) ** (lvl-1), clamped
    g = (0.8 - (level - 1) * 0.007) ** (level - 1)
    g = max(0.015, min(0.8, g))
    _GRAVITY_CACHE[level] = g
    return g

_GRAVITY_CACHE: dict[int, float] = {1: 0.8, 2: 0.72, 3: 0.63, 4: 0.55,
    5: 0.47, 6: 0.38, 7: 0.30, 8: 0.22, 9: 0.15, 10: 0.10}

LINE_SCORES = {0: 0, 1: 100, 2: 300, 3: 500, 4: 800}

HIGHSCORE_PATH = os.path.join(os.path.expanduser("~"), ".alientris_highscore.json")
SETTINGS_PATH = os.path.join(os.path.expanduser("~"), ".alientris_settings.json")
# Previous names — scores/settings carry over automatically on first run.
LEGACY_HIGHSCORES = [os.path.join(os.path.expanduser("~"), p) for p in
                     (".caketris_highscore.json", ".tetris_terminal_highscore.json")]
LEGACY_SETTINGS = [os.path.join(os.path.expanduser("~"), ".caketris_settings.json")]


def _load_json(paths: list[str]) -> dict | None:
    for path in paths:
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
        except Exception:
            continue
    return None

