               "Z": "RED", "J": "YELLOW", "L": "MAGENTA"},
}


def load_settings() -> dict:
    defaults = {"ghost": True, "mono": False, "next": VISIBLE_NEXT,
                "skin": "Solid", "theme": "Classic"}
    data = _load_json([SETTINGS_PATH] + LEGACY_SETTINGS) or {}
    for k, v in defaults.items():
        if k in data:
            defaults[k] = data[k]
    if defaults["skin"] not in TETRIS_SKINS:
        defaults["skin"] = "Solid"
    if defaults["theme"] not in TETRIS_THEMES:
        defaults["theme"] = "Classic"
    try:
        defaults["next"] = min(5, max(1, int(defaults.get("next", 5))))
    except Exception:
        defaults["next"] = VISIBLE_NEXT
    return defaults


def save_settings(ghost: bool, mono: bool, nxt: int, skin: str, theme: str) -> None:
    try:
        with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
            json.dump({"ghost": ghost, "mono": mono, "next": nxt,
                       "skin": skin, "theme": theme}, f)
    except Exception:
        pass

# Piece colors -> curses color index (mapped later). 1..7
PIECE_IDS = {"I": 1, "O": 2, "T": 3, "S": 4, "Z": 5, "J": 6, "L": 7}
ID_TO_PIECE = {v: k for k, v in PIECE_IDS.items()}

