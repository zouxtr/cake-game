#!/usr/bin/env python3
"""Alien arcade picker — choose your game, then play.

  alien-games    # shows the picker
"""
from __future__ import annotations

import os
import shutil
import sys

GAMES = [
    ("alientris", "👽 Alientris",
     "Polished terminal Tetris — stack, spin & clear lines.",
     "Arrows move · Space hard drop · ESC menu"),
    ("alien-man", "👻 Alien-Man",
     "Pac-Man-style maze chase — eat every crumb, dodge the ghosts.",
     "Arrows/WASD step · power treats = revenge · ESC menu"),
    ("alien-pong", "🏓 Alien-Pong",
     "Single-player Pong — beat the CPU, first to the win score.",
     "↑/↓ or W/S move · rallies speed up · ESC menu"),
    ("alien-break", "🧱 Alien-Break",
     "Breakout clone — smash every brick, don't drop the ball.",
     "←/→ move · SPACE launch · ESC menu"),
]


def find_game(cmd: str) -> str | None:
    here = os.path.dirname(os.path.abspath(__file__))
    cand = os.path.join(here, cmd)
    if os.path.isfile(cand) and os.access(cand, os.X_OK):
        return cand
    return shutil.which(cmd)


def pick(stdscr) -> str | None:
    import curses
    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.timeout(100)
    try:
        curses.set_escdelay(25)
    except Exception:
        pass
    try:
        _mm = getattr(curses, "BUTTON1_CLICKED", 0) | getattr(
            curses, "BUTTON1_PRESSED", 0) or getattr(curses, "ALL_MOUSE_EVENTS", 0)
        curses.mousemask(_mm)
    except Exception:
        pass
    idx = 0
    btns: list[tuple[int, int, int]] = []  # (y, x, w) per game

    def draw() -> None:
        stdscr.erase()
        maxy, maxx = stdscr.getmaxyx()
        title = "★  ALIEN ARCADE  ★"
        try:
            stdscr.addstr(2, max(0, (maxx - len(title)) // 2), title,
                          curses.A_BOLD | curses.A_REVERSE)
            sub = "pick your game — ↑↓ + Enter (or 1/2/3, or click)"
            stdscr.addstr(4, max(0, (maxx - len(sub)) // 2), sub, curses.A_DIM)
        except Exception:
            pass
        btns.clear()
        y = 7
        for i, (_cmd, name, desc, keys) in enumerate(GAMES):
            label = f"[ {i + 1}. {name} ]"
            x = max(0, (maxx - len(label)) // 2)
            try:
                stdscr.addstr(y, x, label,
                              curses.A_REVERSE | curses.A_BOLD if i == idx
                              else curses.A_BOLD)
                stdscr.addstr(y + 1, max(0, (maxx - len(desc)) // 2), desc)
                stdscr.addstr(y + 2, max(0, (maxx - len(keys)) // 2), keys,
                              curses.A_DIM)
            except Exception:
                pass
            btns.append((y, x, len(label)))
            y += 5
        try:
            foot = "Q quit"
            stdscr.addstr(maxy - 2, max(0, (maxx - len(foot)) // 2), foot,
                          curses.A_DIM)
        except Exception:
            pass
        stdscr.refresh()

    while True:
        draw()
        try:
            key = stdscr.getch()
        except Exception:
            key = -1
        if key == -1:
            continue
        if key in (ord("q"), ord("Q"), 27):
            return None
        if key in (curses.KEY_UP, ord("k"), ord("K")):
            idx = (idx - 1) % len(GAMES)
        elif key in (curses.KEY_DOWN, ord("j"), ord("J")):
            idx = (idx + 1) % len(GAMES)
        elif 49 <= key <= 57 and (key - 49) < len(GAMES):
            return GAMES[key - 49][0]
        elif key in (curses.KEY_ENTER, 10, 13, ord(" ")):
            return GAMES[idx][0]
        elif key == getattr(curses, "KEY_MOUSE", -9999):
            try:
                _id, mx, my, _z, _b = curses.getmouse()
            except Exception:
                continue
            for i, (by, bx, bw) in enumerate(btns):
                if by == my and bx <= mx < bx + bw:
                    return GAMES[i][0]


def main() -> int:
    try:
        import curses
    except Exception as exc:
        if os.name == "nt":
            print("Install windows-curses first: pip install windows-curses",
                  file=sys.stderr)
            return 2
        print(f"curses is required: {exc}", file=sys.stderr)
        return 2

    choice = curses.wrapper(pick)
    if choice is None:
        return 0
    target = find_game(choice)
    if target is None:
        print(f"Couldn't find '{choice}'. Is it installed and on your PATH?",
              file=sys.stderr)
        return 1
    os.execvp(target, [target])


if __name__ == "__main__":
    raise SystemExit(main())
